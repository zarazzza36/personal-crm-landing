---
interface Props {
  /** vertical: drives up, mobile and desktop sizes; horizontal: drives right, desktop size only */
  orientation: "vertical" | "horizontal";
  /** Position on the road */
  class?: string;
}

const { orientation, class: className } = Astro.props;
---

{
  orientation === "vertical" ? (
    <div class:list={["absolute h-58 w-30 lg:h-72 lg:w-38", className]}>
      <div class="absolute inset-0 rounded-9 bg-car shadow-hard-5-6 lg:rounded-11 lg:shadow-hard-6-8" />
      <div class="absolute inset-x-4 top-10 h-10 rounded-3 bg-glass-car lg:inset-x-5 lg:top-12 lg:h-13 lg:rounded-4" />
      <div class="absolute inset-x-4 bottom-8 h-7 rounded-2 bg-glass-car lg:inset-x-5 lg:bottom-10 lg:h-9 lg:rounded-3" />
    </div>
  ) : (
    <div class:list={["absolute h-38 w-72", className]}>
      <div class="absolute inset-0 rounded-11 bg-car shadow-hard-6-8" />
      <div class="absolute inset-y-5 right-12 w-13 rounded-4 bg-glass-car" />
      <div class="absolute inset-y-5 left-10 w-9 rounded-3 bg-glass-car" />
    </div>
  )
}
