---
import CtaButton from "./CtaButton.astro";
---

<header class="relative z-2 flex items-center justify-between px-24 py-22 lg:mx-auto lg:box-content lg:max-w-1280 lg:px-48 lg:py-28">
  <div class="flex items-center gap-10 font-display text-15 font-bold tracking-logo lg:gap-12 lg:text-18">
    <span class="size-14 rounded-3 bg-accent lg:size-16"></span>Волки с Лизюкова
  </div>
  <div class="flex items-center gap-28">
    <span class="text-11 tracking-label text-dim lg:text-12">ДЛЯ ЛОГИСТОВ</span>
    <CtaButton variant="outline" class="max-lg:hidden" />
  </div>
</header>
