---
import "../styles/global.css";
import unboundedCyrillic from "../assets/fonts/unbounded-cyrillic.woff2?url";
import unboundedLatin from "../assets/fonts/unbounded-latin.woff2?url";
import plexMonoCyrillic from "../assets/fonts/ibm-plex-mono-400-cyrillic.woff2?url";
import plexMonoLatin from "../assets/fonts/ibm-plex-mono-400-latin.woff2?url";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const fonts = [unboundedCyrillic, unboundedLatin, plexMonoCyrillic, plexMonoLatin];

// Link preview in messengers. The image is a screenshot of design/og-image.html
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const previewImageUrl = new URL("/og-image.png", Astro.site);
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="Волки с Лизюкова" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={previewImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Волки с Лизюкова. Своя логистическая база всегда под рукой!" />
    <meta name="twitter:card" content="summary_large_image" />
    {fonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
  </head>
  <body class="bg-grid font-mono text-paper">
    <slot />
  </body>
</html>
